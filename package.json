    "node": ">=20"
  },
  "dependencies": {
    "@xenova/transformers": "2.17.2"
  },
  "devDependencies": {
    "sharp": "0.35.3"
  },
  "overrides": {
    "protobufjs": "^7.6.3",
    "sharp": "0.35.3"
  }
}
