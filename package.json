{
  "name": "speakeasy",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "SpeakEasy voice-to-text application",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "build": "node scripts/build-web.mjs",
    "stage:windows": "node scripts/stage-windows.mjs",
    "build:windows": "npm run stage:windows && npm --prefix electron run dist",
