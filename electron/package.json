{
  "build": {
    "win": {
      "target": [
        "nsis"
      ]
    },
    "files": [
      "index.js",
      "dist/**/*"
    ],
    "appId": "com.forgefront.speakeasy",
    "productName": "SpeakEasy",
    "directories": {
      "output": "build"
    }
  },
  "name": "speakeasy",
  "version": "0.1.0",
  "description": "SpeakEasy voice-to-text desktop application",
  "main": "index.js",
  "scripts": {
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
