{
  "name": "speakeasy-mobile",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "android": "npx cap open android",
    "sync:web": "node -e \"const fs=require('fs');const path=require('path');const src=path.join('..','web');const dest='www';fs.rmSync(dest,{recursive:true,force:true});fs.cpSync(src,dest,{recursive:true});\"",
    "sync": "npm run sync:web && npx cap sync",
    "build:aab": "npm run sync && cd android && gradlew.bat bundleRelease",
    "build:apk": "npm run sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "typescript": "^5.6.3"
  }
}

